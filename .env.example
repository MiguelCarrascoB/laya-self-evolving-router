# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
# Optional: any OpenAI-compatible endpoint (OpenAI-compatible providers, LMStudio, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
# Fallback when the primary provider is unreachable (LMStudio default port)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen2.5-7b-instruct
# Few-shot examples in the proposer system prompt: full | three | none
LAYASYS_FEWSHOT=full
